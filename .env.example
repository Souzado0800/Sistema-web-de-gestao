# ==============================================================================
# SISTEMA DE GESTÃO DE ESTOQUE — VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Configure estas variáveis no painel da Netlify em:
# Site configuration > Environment variables
# ==============================================================================

# 1. URL de conexão com o Banco de Dados PostgreSQL gerenciado (Neon, Supabase, Railway, etc.)
# Exemplo Neon: postgres://user:password@ep-something.us-east-2.aws.neon.tech/neondb?sslmode=require
# Exemplo Supabase: postgresql://postgres:password@db.something.supabase.co:5432/postgres
DATABASE_URL=postgresql://usuario:senha@seu-cluster.neon.tech/neondb?sslmode=require

# 2. Segredo para assinatura de tokens JWT (HS256)
# Gere uma chave aleatória segura com no mínimo 64 caracteres:
# Exemplo: openssl rand -base64 48
JWT_SECRET=substitua_por_uma_chave_secreta_longa_e_aleatoria_para_producao

# 3. Tempo de expiração do Token JWT (ex: 8h, 24h, 7d)
JWT_EXPIRES_IN=12h

# 4. Ambiente de execução (production, development, test)
APP_ENV=production

# 5. Nome da Empresa / Sistema (exibido na interface)
COMPANY_NAME=Empresa Gestão de Estoque

# 6. Permitir estoque negativo em saídas (false por padrão para garantir integridade física)
ALLOW_NEGATIVE_STOCK=false

# 7. Porta para execução do servidor local de desenvolvimento (opcional)
PORT=8080
